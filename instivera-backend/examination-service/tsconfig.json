{
          "compilerOptions": {
                    "target": "ES2020",
                    "module": "commonjs",
                    "lib": [
                              "ES2020"
                    ],
                    "paths": {
                        "@shared/*": ["../shared/*"]
                    },
                    "outDir": "./dist",
                    "rootDirs": [
                    "./src",
                    "../shared"
                    ],
                    "strict": false,
                    "esModuleInterop": true,
                    "skipLibCheck": true,
                    "forceConsistentCasingInFileNames": true,
                    "resolveJsonModule": true,
                    "declaration": true,
                    "declarationMap": true,
                    "sourceMap": true,
                    "moduleResolution": "node",
                    "allowSyntheticDefaultImports": true,
                    "noImplicitAny": false,
                    "strictNullChecks": false,
                    "types": ["node"]
          },
          "include": [
                    "src/**/*"],
          "exclude": [
                    "node_modules",
                    "dist"
          ]
}