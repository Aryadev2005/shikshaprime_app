# Google Gemini API key — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model for heavy generation nodes (activities, assessments, standards, chapter_extraction)
MODEL_NAME_HEAVY=gemini-2.5-flash

# Gemini model for lightweight generation nodes (prerequisites, materials, differentiation, homework, time_breakdown)
MODEL_NAME_LIGHT=gemini-2.5-flash

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Validation limits
MAX_LESSON_DURATION=240
CHAPTER_TEXT_MIN_LENGTH=50
CHAPTER_TEXT_MAX_LENGTH=50000



# Retry policy
LLM_MAX_RETRIES=2

# Seconds to wait after a 429 rate-limit response before retrying (free tier = 5 RPM, ~59s reset)
RATE_LIMIT_RETRY_DELAY_SECONDS=65

# Pipeline execution timeout in seconds — must be > (nodes × call_time + rate_limit_wait)
# Free tier needs ~3 min; 600s gives plenty of headroom
PIPELINE_TIMEOUT_SECONDS=600

# PDF upload limits (Mode B — Approach 3: Gemini native PDF reading)
# Maximum PDF file size accepted by POST /generate-with-pdf (in megabytes)
MAX_PDF_SIZE_MB=20

# Regeneration (S3) — max characters a teacher can type in the "what to change" box
USER_INSTRUCTION_MAX_LENGTH=500

# Observability
REQUEST_ID_LENGTH=12
