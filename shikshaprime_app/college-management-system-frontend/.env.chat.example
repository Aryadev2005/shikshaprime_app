# Chat System Environment Configuration

# Add these environment variables to your .env.local file

# Chat Service API URL
NEXT_PUBLIC_CHAT_API_URL=http://localhost:5005/api/chat

# Chat Service WebSocket URL (optional - for real-time features)
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:5005

# Chat Configuration
NEXT_PUBLIC_CHAT_ENABLED=true
NEXT_PUBLIC_CHAT_REFRESH_INTERVAL=30000
NEXT_PUBLIC_CHAT_MAX_MESSAGE_LENGTH=5000