# Payment Service Configuration
SERVICE_PORT=9053
NODE_ENV=development

# JWT (must match identity-service)
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=REPLACE_WITH_DB_NAME

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID=REPLACE_WITH_MERCHANT_ID
PHONEPE_SALT_KEY=REPLACE_WITH_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
