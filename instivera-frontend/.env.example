# Backend origin used by src/config/env.ts (api client + socket).
# Must include the /api/mobile prefix.
#
# Resolution order if this is unset:
#   1. app.json  -> expo.extra.apiUrl        (unset by default)
#   2. Metro debug host                      (auto-detected; best for devices)
#   3. http://127.0.0.1:4000/api/mobile      (simulator fallback)
#
# Simulator / emulator:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api/mobile
# Physical device — use your machine's LAN IP, not localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/mobile
EXPO_PUBLIC_API_URL=http://localhost:4000/api/mobile
