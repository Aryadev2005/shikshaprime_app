# Bare backend origin used by src/config/env.ts (api client + socket).
# No path suffix — each api/modules/*.ts call supplies its own /api/<service> prefix.
#
# Resolution order if this is unset:
#   1. app.json  -> expo.extra.apiUrl        (unset by default)
#   2. Metro debug host                      (auto-detected; best for devices)
#   3. http://127.0.0.1:4000                 (simulator fallback)
#
# Real backend:
#   EXPO_PUBLIC_API_URL=https://collegec.mainapp.instivera.com:8081
# Simulator against a local backend:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# Physical device against a local backend — use your machine's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=https://collegec.mainapp.instivera.com:8081